# Tracker UI is a BFF — all auth + data come from workforce-backend.
# Do NOT point this app at a separate tracker database for login.
# Required:
BACKEND_API_BASE_URL=http://localhost:4000/api/v1

# Used for invite / portal deep links when sending mail from this app (optional).
ADMIN_PORTAL_URL=http://localhost:3000

# Optional public base if absolute URLs are needed in the browser.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Edge cookie gate checks tracker_access / tracker_refresh cookie presence.
# DATABASE_URL is NOT used for Task Tracker login (Workforce API owns users).
