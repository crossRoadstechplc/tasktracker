# Tracker UI is a BFF — APIs live on workforce-backend (no Prisma at runtime).
# Required on Vercel / production:
BACKEND_API_BASE_URL=https://YOUR_WORKFORCE_API_HOST/api/v1

# Used for invite / portal deep links when sending mail from this app (optional).
ADMIN_PORTAL_URL=https://YOUR_ADMIN_PORTAL_HOST

# Optional public base if absolute URLs are needed in the browser.
# NEXT_PUBLIC_API_BASE_URL=https://YOUR_WORKFORCE_API_HOST/api/v1

# Edge cookie gate still checks tracker_access / tracker_refresh cookie presence.
# JWT_SECRET / DATABASE_URL are NOT required for the Vercel BFF deploy.
